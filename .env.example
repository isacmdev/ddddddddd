# Supabase configuration
# Get these from your Supabase project dashboard: Settings > API
# Then place this file at C:\ProgramData\ControlParental\.env
# (Service looks for .env in repo root first, then in ProgramData)

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional: WNS push notification (T19, production only)
# WNS_PACKAGE_SID=
# WNS_CLIENT_SECRET=
# WNS_AAD_APP_ID=

# Optional: TLS certificate pinning (T22, production only)
# SUPABASE_CERT_PIN=
