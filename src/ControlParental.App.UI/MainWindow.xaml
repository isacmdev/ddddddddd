<ui:Window
    x:Class="ControlParental.App.UI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml"
    Title="Control Parental">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            Live-shell header — T26 page host layout.
            The header binds through StringsAdapter so the localized copy stays
            in the canonical Strings/{es,en-US}/Strings.resw catalog
            (design.md Â§10, ADR-007).
        -->
        <Grid Grid.Row="0" Margin="24,16,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Text="{x:Bind Strings.ProtectionActiveOverlay, Mode=OneTime}"
                FontSize="20"
                FontWeight="SemiBold"
                Foreground="#0078D4"
                VerticalAlignment="Center" />

            <ProgressBar
                Grid.Column="1"
                Width="180"
                Height="8"
                Minimum="0"
                Maximum="4"
                Value="{x:Bind ViewModel.ProgressCount, Mode=OneWay}"
                Foreground="#0078D4" />
        </Grid>

        <!--
            Routed page host — T26 PR #11 / Unit 2 (ADR-006).
            The shell navigates the canonical six-step route catalog
            (OnboardingRouteCatalog) and mounts the matching in-app page here.
            Pages wire their own completion callbacks back to
            MainWindow.OnStepCompletedAsync which drives the IPC-backed
            OnboardingViewModel.
        -->
        <ContentControl Grid.Row="1" x:Name="PageHost" />
    </Grid>
</ui:Window>
