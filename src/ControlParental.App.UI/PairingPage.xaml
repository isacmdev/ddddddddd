<Page
    x:Class="ControlParental.App.UI.PairingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <!-- Header -->
                <TextBlock
                    Text="{x:Bind Strings.PairYourDeviceTitle, Mode=OneTime}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1A1A1A"
                    Margin="0,24,0,16" />

                <TextBlock
                    Text="{x:Bind Strings.PairingDescription, Mode=OneTime}"
                    FontSize="16"
                    TextWrapping="Wrap"
                    Foreground="#666666"
                    Margin="0,0,0,24" />

                <!--
                    Age band selection — T26 PR #5 (Fase 3 / ADR-004).

                    The user-facing copy is "7-12 años" / "13-16 años" /
                    "17-18 años". The IPC wire payload MUST NOT carry that
                    localized copy; it carries the canonical "7-12" /
                    "13-16" / "17-18" string. We bind the wire value via
                    Tag so the visible Content is decoupled from the value
                    sent over the wire. If a future contributor changes the
                    Content to "7 a 12 años" by accident, the wire value
                    stays correct.

                    SelectedAgeBandIndex starts at -1 (see the VM field
                    initializer) so the ComboBox has no item preselected —
                    the user must explicitly pick a band before the Emparejar
                    button enables (gated by the VM's CanPair property).
                -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.PairingAgeBandPrompt, Mode=OneTime}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,12" />
                        <ComboBox
                            x:Name="AgeBandCombo"
                            SelectedIndex="{Binding SelectedAgeBandIndex, Mode=TwoWay}"
                            Width="200"
                            HorizontalAlignment="Left"
                            PlaceholderText="{x:Bind Strings.PairingAgeBandPlaceholder, Mode=OneTime}">
                            <ComboBoxItem Content="{x:Bind Strings.AgeBand_7_12, Mode=OneTime}" Tag="7-12" />
                            <ComboBoxItem Content="{x:Bind Strings.AgeBand_13_16, Mode=OneTime}" Tag="13-16" />
                            <ComboBoxItem Content="{x:Bind Strings.AgeBand_17_18, Mode=OneTime}" Tag="17-18" />
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Code Entry -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.PairingCodePrompt, Mode=OneTime}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,16" />

                        <!-- 8-character code entry -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBox
                                x:Name="Digit1"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit2"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit3"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit4"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit5"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit6"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit7"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                            <TextBox
                                x:Name="Digit8"
                                Width="40"
                                Height="48"
                                FontSize="24"
                                TextAlignment="Center"
                                MaxLength="1"
                                Margin="8,0,0,0"
                                TextChanged="OnDigitTextChanged" />
                        </StackPanel>

                        <!-- Error Message -->
                        <TextBlock
                            x:Name="ErrorText"
                            Text="{Binding ErrorMessage}"
                            Foreground="#D13438"
                            FontSize="14"
                            TextWrapping="Wrap"
                            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,0,0,16" />

                        <!--
                            Pair Button — T26 PR #5: the enable gate moved
                            from IsPairing (only "request in flight") to the
                            VM's CanPair derived property, which combines the
                            in-flight state with a complete code AND a
                            selected age band. The progress bar below still
                            shows IsPairing so the user sees the spinner only
                            while we wait for the Service.
                        -->
                        <Button
                            x:Name="PairButton"
                            Content="{x:Bind Strings.PairingAction, Mode=OneTime}"
                            Padding="24,14"
                            HorizontalAlignment="Stretch"
                            Background="#0078D4"
                            Foreground="White"
                            FontSize="16"
                            IsEnabled="{Binding CanPair}"
                            Click="OnPairClick" />

                        <ProgressBar
                            x:Name="PairingProgress"
                            IsIndeterminate="True"
                            Visibility="{Binding IsPairing, Converter={StaticResource BoolToVisibility}}"
                            Margin="0,16,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>