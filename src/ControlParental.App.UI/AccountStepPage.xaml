<Page
    x:Class="ControlParental.App.UI.AccountStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <!-- Header -->
                <TextBlock
                    Text="{x:Bind Strings.AccountTitle, Mode=OneTime}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1A1A1A"
                    Margin="0,24,0,16" />

                <TextBlock
                    Text="{x:Bind Strings.AccountDescription, Mode=OneTime}"
                    FontSize="16"
                    TextWrapping="Wrap"
                    Foreground="#666666"
                    Margin="0,0,0,24" />

                <!-- Loading -->
                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,16" />

                <!-- Error Message -->
                <Border Background="#FFF3F3" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{Binding ErrorMessage}"
                        Foreground="#D13438"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Elevation Required -->
                <Border Background="#FFF4CE" CornerRadius="4" Padding="12" Margin="0,0,0,16"
                        Visibility="{Binding RequiresElevation, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind Strings.AccountElevationRequired, Mode=OneTime}"
                        Foreground="#7A4E00"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Account List -->
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,0,0,16"
                        Visibility="{Binding IsLoading, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.AccountExistingHeader, Mode=OneTime}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,12" />

                        <ListView x:Name="AccountList" ItemsSource="{Binding Accounts}" Margin="0,0,0,12">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding Username}" FontSize="16" Foreground="#1A1A1A" />
                                            <TextBlock Text="{Binding TypeDisplayName}" FontSize="12" Foreground="#666666" />
                                        </StackPanel>
                                        <Button Grid.Column="1"
                                                Content="Usar"
                                                Padding="12,6"
                                                Background="#0078D4"
                                                Foreground="White"
                                                Click="OnUseAccountClick"
                                                 Tag="{Binding}" />
                                     </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                            <Button Content="{x:Bind Strings.AccountCreateNew, Mode=OneTime}"
                                    Padding="16,10"
                                    Background="#0078D4"
                                    Foreground="White"
                                    Command="{Binding ShowCreateCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{x:Bind Strings.AccountConvertExisting, Mode=OneTime}"
                                    Padding="16,10"
                                    Background="Transparent"
                                    Foreground="#0078D4"
                                    Command="{Binding ShowConvertCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Create Account Form -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding ShowCreateForm, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.AccountCreateNew, Mode=OneTime}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,16" />

                        <TextBlock Text="{x:Bind Strings.AccountUsernameLabel, Mode=OneTime}" FontSize="14" Foreground="#666666" Margin="0,0,0,4" />
                        <TextBox Text="{Binding NewAccountUsername, Mode=TwoWay}"
                                 PlaceholderText="{x:Bind Strings.AccountUsernamePlaceholder, Mode=OneTime}"
                                 Padding="12,10"
                                 Margin="0,0,0,12" />

                        <TextBlock Text="{x:Bind Strings.AccountPasswordLabel, Mode=OneTime}" FontSize="14" Foreground="#666666" Margin="0,0,0,4" />
                        <PasswordBox x:Name="NewPasswordBox"
                                     Padding="12,10"
                                     Margin="0,0,0,16" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Bind Strings.AccountCancel, Mode=OneTime}"
                                    Padding="16,10"
                                    Background="Transparent"
                                    Foreground="#666666"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{x:Bind Strings.AccountCreate, Mode=OneTime}"
                                    Padding="16,10"
                                    Background="#0078D4"
                                    Foreground="White"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                    Click="OnCreateClick" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Convert Account Form -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,16"
                        Visibility="{Binding ShowConvertForm, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.AccountConvertExisting, Mode=OneTime}"
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,16" />

                        <TextBlock
                            Text="{x:Bind Strings.AccountConvertDescription, Mode=OneTime}"
                            FontSize="14"
                            Foreground="#666666"
                            TextWrapping="Wrap"
                            Margin="0,0,0,16" />

                        <ListView ItemsSource="{Binding Accounts}" Margin="0,0,0,16">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Username}" VerticalAlignment="Center" />
                                         <RadioButton Grid.Column="1"
                                                      GroupName="ConvertAccount"
                                                      Click="OnUseAccountRadioClick"
                                                      Tag="{Binding}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="{x:Bind Strings.AccountCancel, Mode=OneTime}"
                                    Padding="16,10"
                                    Background="Transparent"
                                    Foreground="#666666"
                                    Command="{Binding CancelCommand}"
                                    Margin="0,0,8,0" />
                            <Button Content="{x:Bind Strings.AccountConvert, Mode=OneTime}"
                                    Padding="16,10"
                                    Background="#0078D4"
                                    Foreground="White"
                                    IsEnabled="{Binding IsProcessing, Converter={StaticResource InverseBool}}"
                                    Command="{Binding ConvertAccountCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Processing Indicator -->
                <ProgressBar
                    IsIndeterminate="True"
                    Visibility="{Binding IsProcessing, Converter={StaticResource BoolToVisibility}}"
                    Margin="0,0,0,16" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>