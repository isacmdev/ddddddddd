<Page
    x:Class="ControlParental.App.UI.ManagedStepPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <!-- Header -->
                <TextBlock
                    Text="{x:Bind Strings.ManagedTitle, Mode=OneTime}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1A1A1A"
                    Margin="0,24,0,16" />

                <TextBlock
                    Text="{x:Bind Strings.ManagedDescription, Mode=OneTime}"
                    FontSize="16"
                    TextWrapping="Wrap"
                    Foreground="#666666"
                    Margin="0,0,0,24" />

                <!--
                    Current enforcement level card — T26 PR #6 (Fase 4).
                    Displays the live EnforcementLevel reported by the
                    IEnforcementLevelMonitor. Bound to the VM's
                    CurrentEnforcementLevelDisplay so the view updates when
                    the Service-driven LevelChanged event fires.
                -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.ManagedCurrentLevelHeader, Mode=OneTime}"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,12" />
                        <Border
                            Background="#E8F4FD"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Left">
                            <TextBlock
                                Text="{Binding CurrentEnforcementLevelDisplay, Mode=OneWay}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#0078D4" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--
                    Managed upgrade card — visible only on editions that allow
                    MANAGED enforcement (Pro+/Enterprise/Education). On Home
                    the card collapses and the unavailable-edition message
                    below takes its place so the user can still close out the
                    onboarding flow.
                -->
                <Border
                    Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,24"
                    Visibility="{Binding CurrentEditionSupportsManaged, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.ManagedActivateCardTitle, Mode=OneTime}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="{x:Bind Strings.ManagedActivateDescription, Mode=OneTime}"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="#666666"
                            Margin="0,0,0,16" />
                        <Button
                            x:Name="ActivateManagedButton"
                            Content="{x:Bind Strings.ManagedActivateAction, Mode=OneTime}"
                            Padding="24,14"
                            HorizontalAlignment="Stretch"
                            Background="#0078D4"
                            Foreground="White"
                            FontSize="16"
                            Command="{Binding FinishCommand}"
                            Click="OnActivateManagedClick" />
                    </StackPanel>
                </Border>

                <!--
                    Unavailable-edition message — T26 PR #6 (Fase 4).
                    On Home (or any edition that does not permit MANAGED) we
                    still allow the user to finish onboarding without a
                    managed upgrade — the standard protection is enough.
                    The button calls the same FinishCommand as the upgrade
                    card; the VM treats both paths identically and only
                    invokes the onCompleted callback.
                -->
                <Border
                    Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,24"
                    Visibility="{Binding CurrentEditionSupportsManaged, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.ManagedNotAvailableInEdition, Mode=OneTime}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="{x:Bind Strings.ManagedNotAvailableDescription, Mode=OneTime}"
                            FontSize="13"
                            TextWrapping="Wrap"
                            Foreground="#666666"
                            Margin="0,0,0,16" />
                        <Button
                            x:Name="FinishButton"
                            Content="{x:Bind Strings.ManagedFinishOnboarding, Mode=OneTime}"
                            Padding="24,14"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            Foreground="#0078D4"
                            FontSize="16"
                            Command="{Binding FinishCommand}"
                            Click="OnFinishClick" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
