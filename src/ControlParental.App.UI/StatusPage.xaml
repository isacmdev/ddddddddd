<Page
    x:Class="ControlParental.App.UI.StatusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls"
    xmlns:domain="using:ControlParental.Domain">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <!-- Header -->
                <TextBlock
                    Text="Mi tiempo"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1A1A1A"
                    Margin="0,24,0,16" />

                <!-- Time Remaining Card -->
                <Border Background="White" CornerRadius="8" Padding="32" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="{Binding StatusSummary}"
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="#0078D4"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,8" />

                        <TextBlock
                            Text="Nivel de protección"
                            FontSize="12"
                            Foreground="#666666"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0" />

                        <Border
                            Background="#E8F4FD"
                            CornerRadius="4"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            Margin="0,4,0,0">
                            <TextBlock
                                Text="{Binding CurrentLevel}"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="#0078D4" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Current App Card -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="App en uso"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#666666"
                            Margin="0,0,0,8" />
                        <TextBlock
                            Text="{Binding CurrentAppId, FallbackValue='Ninguna'}"
                            FontSize="16"
                            Foreground="#1A1A1A"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Active Grants Card -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="Tiempo extra"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#666666"
                            Margin="0,0,0,8" />

                        <TextBlock
                            Text="No tenés tiempo extra activo."
                            FontSize="14"
                            Foreground="#999999"
                            Margin="0,0,0,8"
                            Visibility="{Binding HasNoGrants, Converter={StaticResource BoolToVisibility}}" />

                        <ItemsControl ItemsSource="{Binding ActiveGrants}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock
                                            Text="{Binding Scope}"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#1A1A1A" />
                                        <TextBlock
                                            Text="{Binding Source, Converter={StaticResource GrantSourceDisplay}}"
                                            FontSize="12"
                                            Foreground="#666666" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Active Issues Card -->
                <Border
                    Background="White"
                    CornerRadius="8"
                    Padding="24"
                    Margin="0,0,0,24"
                    Visibility="{Binding HasActiveIssues, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock
                            Text="Problemas detectados"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#D13438"
                            Margin="0,0,0,8" />

                        <ItemsControl ItemsSource="{Binding ActiveIssues}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        Text="{Binding Description}"
                                        FontSize="13"
                                        Foreground="#1A1A1A"
                                        Margin="0,0,0,4"
                                        TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Action Buttons -->
                <Button
                    Content="Pedir tiempo extra"
                    Padding="24,14"
                    HorizontalAlignment="Stretch"
                    Background="#0078D4"
                    Foreground="White"
                    FontSize="16"
                    Command="{Binding RequestTimeCommand}"
                    Margin="0,0,0,12" />

                <Button
                    Content="Actualizar"
                    Padding="24,14"
                    HorizontalAlignment="Stretch"
                    Background="Transparent"
                    Foreground="#0078D4"
                    FontSize="14"
                    Command="{Binding RefreshCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
