<Page
    x:Class="ControlParental.App.UI.ConsentPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="using:Microsoft.UI.Xaml.Controls">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24">
            <StackPanel MaxWidth="600" HorizontalAlignment="Center">
                <!-- Header -->
                <TextBlock
                    Text="{x:Bind Strings.DisclosureTitle, Mode=OneTime}"
                    FontSize="28"
                    FontWeight="Bold"
                    Foreground="#1A1A1A"
                    Margin="0,24,0,16" />

                <!-- Disclosure Card -->
                <Border Background="White" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock
                            Text="{x:Bind Strings.DisclosureBody, Mode=OneTime}"
                            FontSize="16"
                            TextWrapping="Wrap"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,16" />

                        <TextBlock
                            Text="Datos recolectados:"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#1A1A1A"
                            Margin="0,0,0,8" />

                        <StackPanel Margin="16,0,0,0">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="• " Foreground="#0078D4" />
                                <TextBlock Text="Tiempo de uso por aplicación" TextWrapping="Wrap" Foreground="#666666" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="• " Foreground="#0078D4" />
                                <TextBlock Text="Nombre de apps usadas" TextWrapping="Wrap" Foreground="#666666" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="• " Foreground="#0078D4" />
                                <TextBlock Text="Hora de uso" TextWrapping="Wrap" Foreground="#666666" />
                            </StackPanel>
                        </StackPanel>

                        <Border Background="#FFF3F3" CornerRadius="4" Padding="12" Margin="0,16,0,0">
                            <TextBlock
                                Text="No se recolecta contenido de mensajes, información personal ni contraseñas."
                                FontSize="14"
                                Foreground="#D13438"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Consent persist error (T26 Fase 1) -->
                <Border
                    Background="#FFF3F3"
                    CornerRadius="4"
                    Padding="12"
                    Margin="0,0,0,12"
                    Visibility="{x:Bind HasError, Mode=OneWay, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        Text="{x:Bind ErrorMessage, Mode=OneWay}"
                        FontSize="14"
                        Foreground="#D13438"
                        TextWrapping="Wrap" />
                </Border>

                <!-- Action Buttons -->
                <Button
                    Content="{x:Bind Strings.AcceptButton, Mode=OneTime}"
                    Padding="24,14"
                    HorizontalAlignment="Stretch"
                    Background="#0078D4"
                    Foreground="White"
                    FontSize="16"
                    IsEnabled="{x:Bind IsBusy, Mode=OneWay, Converter={StaticResource InverseBool}}"
                    Click="OnAcceptClick" />

                <Button
                    Content="{x:Bind Strings.ViewTransparencyButton, Mode=OneTime}"
                    Padding="24,14"
                    HorizontalAlignment="Stretch"
                    Margin="0,12,0,0"
                    Background="Transparent"
                    Foreground="#0078D4"
                    FontSize="14"
                    Click="OnViewTransparencyClick" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
